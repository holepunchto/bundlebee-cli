{
  "name": "bundlebee-cli",
  "version": "1.0.0",
  "description": "Manage, push, sign and seed your Bundles with Bees!",
  "bin": {
    "bundlebee": "index.js"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    }
  },
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "package.json",
    "index.js",
    "index.d.ts"
  ],
  "devDependencies": {
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "scripts": {
    "format": "prettier . --write",
    "test": "prettier . --check && lunte && brittle-bare test/index.js",
    "lint": "lunte"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/bundlebee-cli.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bundlebee-cli/issues"
  },
  "homepage": "https://github.com/holepunchto/bundlebee-cli",
  "dependencies": {
    "bare-fs": "^4.5.5",
    "bare-path": "^3.0.0",
    "bare-process": "^4.2.2",
    "bundlebee": "^1.0.5",
    "corestore": "^7.8.0",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.0",
    "z32": "^1.1.0"
  }
}
